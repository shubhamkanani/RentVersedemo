{
  "name": "logindemoserver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wallet authentication server for RentVerse — SIWE (EIP-4361) login with MetaMask.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:auth": "node scripts/smoke-test.js",
