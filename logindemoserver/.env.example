# Copy to logindemoserver/.env and fill in.
# Validated at boot — the server exits with a readable error if anything is
# missing or malformed (src/config/index.js).

NODE_ENV=development
PORT=4000

# Browser origin(s) allowed to call this API. Comma-separated.
CORS_ORIGIN=http://localhost:3000

# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Bound into the signed message. Must match the origin the user signs from, or
# a signature farmed elsewhere would verify here.
SIWE_DOMAIN=localhost:3000

# Shown in the wallet's signature prompt AND used for contract calls.
# 31337 = local Hardhat node. personal_sign is chain-agnostic, so login works
# whichever network MetaMask is on; only the contract calls care.
CHAIN_ID=31337

# How long a challenge stays valid before it must be re-requested.
NONCE_TTL_SECONDS=300

# --- Chain -------------------------------------------------------------------
# Defaults target the local Hardhat node (cd blockchain && npm run node).
RPC_URL=http://127.0.0.1:8545

# Printed by `cd blockchain && npm run deploy:local` — paste them here.
# Left blank the server still boots; /health reports them as unconfigured.
REAL_ESTATE_ADDRESS=
ESCROW_ADDRESS=
